# Copy to `.env` for local development. Do not commit `.env`.

# Payload API origin. In `vite dev`, requests use `/payload-api` proxy to this URL.
# In production builds, the browser calls this URL directly — use your public Payload HTTPS URL
# and configure Payload CORS for your form-builder origin (e.g. https://forms.example.com).
VITE_PAYLOAD_API_URL=http://localhost:3000

VITE_PAYLOAD_AUTH_SLUG=users

# Optional overrides (defaults shown in src/lib/env.ts)
# VITE_PAYLOAD_FORMS_SLUG=forms
# VITE_PAYLOAD_ORGANIZATIONS_SLUG=organizations
# VITE_PAYLOAD_BRANCHES_SLUG=branches
# VITE_PAYLOAD_FORM_CATEGORIES_SLUG=form-categories

# Dev only: silent auto-login + login form pre-fill. Ignored in production builds (never bundled for auth).
# VITE_PAYLOAD_ADMIN_EMAIL=
# VITE_PAYLOAD_ADMIN_PASSWORD=

# Optional: POST endpoint for AI HTML conversion `{ message }` → `{ html }`
# VITE_AI_CONVERT_URL=
