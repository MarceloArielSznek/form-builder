# OpenAI API key (required for convert-to-HTML)
OPENAI_API_KEY=sk-your-key-here

# Model (optional, default gpt-4o-mini). Use gpt-4o for higher quality design.
OPENAI_MODEL=gpt-4o-mini

# Max tokens per request (optional, default 2048, min 256, max 4096)
OPENAI_MAX_TOKENS=2048

# Server port (optional, default 3456)
# PORT=3456
